  <diagram id="er-model" name="2. ER-модель">
    <mxGraphModel dx="1900" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e-title" value="ER-модель: контент, состояние и журнал боя" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=28;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="42" as="geometry"/></mxCell>
        <mxCell id="e-note" value="PK/FK приведены концептуально. Decimal хранится как NUMERIC. Полиморфные источники разрешаются application service и валидируются при публикации контента." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1240" height="46" as="geometry"/></mxCell>
        <mxCell id="e-leg1" value="Контент" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontStyle=1;fontColor=#403294;" vertex="1" parent="1"><mxGeometry x="1320" y="75" width="150" height="38" as="geometry"/></mxCell>
        <mxCell id="e-leg2" value="Runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontStyle=1;fontColor=#0747A6;" vertex="1" parent="1"><mxGeometry x="1490" y="75" width="150" height="38" as="geometry"/></mxCell>
        <mxCell id="e-leg3" value="Бой / журнал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontStyle=1;fontColor=#006644;" vertex="1" parent="1"><mxGeometry x="1660" y="75" width="180" height="38" as="geometry"/></mxCell>

        <mxCell id="e-stat-def" value="&lt;b&gt;StatDefinition&lt;/b&gt;&#xa;PK id&#xa;UQ key&#xa;title, description&#xa;decimal_scale&#xa;default_value&#xa;min_value?, max_value?&#xa;is_active, version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="165" width="220" height="190" as="geometry"/></mxCell>
        <mxCell id="e-action-def" value="&lt;b&gt;ActionDefinition&lt;/b&gt;&#xa;PK id&#xa;UQ key&#xa;title&#xa;target_policy&#xa;cost_formula?&#xa;cooldown_formula?&#xa;is_active, version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="300" y="165" width="220" height="190" as="geometry"/></mxCell>
        <mxCell id="e-item-template" value="&lt;b&gt;ItemTemplate&lt;/b&gt;&#xa;PK id&#xa;UQ key&#xa;title, item_type&#xa;stackable&#xa;equip_slot?&#xa;is_active, version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="560" y="165" width="220" height="190" as="geometry"/></mxCell>
        <mxCell id="e-source-link" value="&lt;b&gt;EffectSourceLink&lt;/b&gt;&#xa;PK id&#xa;FK effect_definition_id&#xa;source_type ACTION | ITEM&#xa;source_id&#xa;activation EQUIP | USE | HIT&#xa;order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="820" y="165" width="240" height="190" as="geometry"/></mxCell>
        <mxCell id="e-effect-def" value="&lt;b&gt;EffectDefinition&lt;/b&gt;&#xa;PK id&#xa;UQ key&#xa;title&#xa;duration_scope&#xa;duration_formula?&#xa;stacking_policy&#xa;max_stacks&#xa;is_active, version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1100" y="155" width="240" height="210" as="geometry"/></mxCell>
        <mxCell id="e-effect-rule" value="&lt;b&gt;EffectRule&lt;/b&gt;&#xa;PK id&#xa;FK effect_definition_id&#xa;kind STAT_MODIFIER | RESOURCE_DELTA&#xa;     APPLY_EFFECT | BATTLE_FLAG&#xa;target_selector&#xa;stat_key? / resource_key?&#xa;operation ADD | MULTIPLY | OVERRIDE | MIN | MAX&#xa;value_formula, condition_formula?&#xa;phase, priority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1380" y="145" width="310" height="230" as="geometry"/></mxCell>
        <mxCell id="e-effect-trigger" value="&lt;b&gt;EffectTrigger&lt;/b&gt;&#xa;PK id&#xa;FK effect_definition_id&#xa;trigger_type ON_APPLY | TURN_START&#xa;             TURN_END | TIME_INTERVAL&#xa;interval_seconds?&#xa;every_n_turns?&#xa;tick_limit?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAE6FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1100" y="405" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="e-publish" value="&lt;b&gt;ContentPublication&lt;/b&gt;&#xa;Парсинг и типизация DSL&#xa;Проверка ссылок на stat/resource&#xa;Граф зависимостей без циклов&#xa;Иммутабельная опубликованная version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1420" y="425" width="270" height="145" as="geometry"/></mxCell>

        <mxCell id="e-actor" value="&lt;b&gt;Actor&lt;/b&gt;&#xa;PK id&#xa;actor_type CHARACTER | MONSTER&#xa;actor_ref_id&#xa;version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="465" width="220" height="135" as="geometry"/></mxCell>
        <mxCell id="e-actor-stat" value="&lt;b&gt;ActorStatValue&lt;/b&gt;&#xa;PK id&#xa;FK actor_id&#xa;FK stat_definition_id&#xa;base_value NUMERIC&#xa;UQ(actor_id, stat_definition_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="300" y="445" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="e-resource" value="&lt;b&gt;ResourcePool&lt;/b&gt;&#xa;PK id&#xa;FK actor_id&#xa;resource_key&#xa;current_value NUMERIC&#xa;max_stat_key&#xa;UQ(actor_id, resource_key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="580" y="445" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="e-active-effect" value="&lt;b&gt;ActiveEffect&lt;/b&gt;&#xa;PK id&#xa;FK effect_definition_id + version&#xa;FK source_actor_id?&#xa;FK battle_id?&#xa;source_instance_type/id?&#xa;stacks&#xa;started_at, expires_at?&#xa;remaining_turns?, next_tick_at?&#xa;status, version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="860" y="425" width="260" height="220" as="geometry"/></mxCell>
        <mxCell id="e-active-target" value="&lt;b&gt;ActiveEffectTarget&lt;/b&gt;&#xa;PK id&#xa;FK active_effect_id&#xa;FK target_actor_id&#xa;applied_at&#xa;UQ(active_effect_id, target_actor_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="860" y="695" width="260" height="165" as="geometry"/></mxCell>
        <mxCell id="e-scheduled-event" value="&lt;b&gt;ScheduledGameEvent&lt;/b&gt;&#xa;PK id&#xa;event_type EFFECT_TICK | EFFECT_EXPIRE&#xa;aggregate_type/id&#xa;execute_at, status, attempts&#xa;UQ deduplication_key&#xa;payload, processed_at?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="580" y="695" width="240" height="190" as="geometry"/></mxCell>

        <mxCell id="e-battle" value="&lt;b&gt;Battle&lt;/b&gt;&#xa;PK id&#xa;status&#xa;turn_number, active_participant_id&#xa;turn_deadline_at&#xa;rng_seed / rng_state&#xa;version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="745" width="240" height="185" as="geometry"/></mxCell>
        <mxCell id="e-participant" value="&lt;b&gt;BattleParticipant&lt;/b&gt;&#xa;PK id&#xa;FK battle_id&#xa;FK actor_id&#xa;side, join_order&#xa;runtime_state / snapshot&#xa;is_active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="320" y="735" width="240" height="185" as="geometry"/></mxCell>
        <mxCell id="e-battle-action" value="&lt;b&gt;BattleAction&lt;/b&gt;&#xa;PK id&#xa;FK battle_id&#xa;FK initiator_participant_id&#xa;FK target_participant_id?&#xa;FK action_definition_id&#xa;idempotency_key&#xa;command_payload&#xa;turn_number, resolved_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="985" width="260" height="205" as="geometry"/></mxCell>
        <mxCell id="e-battle-event" value="&lt;b&gt;BattleEvent&lt;/b&gt;&#xa;PK id&#xa;FK battle_id&#xa;FK battle_action_id?&#xa;sequence_number&#xa;event_type&#xa;payload (resolved facts)&#xa;created_at&#xa;UQ(battle_id, sequence_number)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="340" y="985" width="260" height="205" as="geometry"/></mxCell>
        <mxCell id="e-snapshot-note" value="&lt;b&gt;Граница хранения&lt;/b&gt;&#xa;ActorStatValue хранит только base_value.&#xa;Итоговые характеристики вычисляются для контекста.&#xa;BattleParticipant может хранить зафиксированный боевой snapshot,&#xa;если правила боя не должны изменяться вслед за внешними эффектами." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="670" y="965" width="450" height="170" as="geometry"/></mxCell>
        <mxCell id="e-invariants" value="&lt;b&gt;Инварианты&lt;/b&gt;&#xa;• Все изменения ресурсов и эффектов — в одной короткой транзакции с Battle.version.&#xa;• Повтор команды отсекается idempotency_key.&#xa;• TIME_INTERVAL создаёт ScheduledGameEvent; обработчик блокирует строки и идемпотентен.&#xa;• ActiveEffect ссылается на опубликованную версию определения: последующее редактирование контента не меняет уже идущий бой.&#xa;• Target selector — правило контента; ActiveEffectTarget — уже разрешённая сервером конкретная цель." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1180" y="695" width="620" height="240" as="geometry"/></mxCell>
        <mxCell id="e-enums" value="&lt;b&gt;Основные enum&lt;/b&gt;&#xa;duration_scope: EQUIPPED | REAL_TIME | TURNS | BATTLE | ACTION&#xa;stacking: INDEPENDENT | STACK | REFRESH | REPLACE&#xa;target: SELF | TARGET | ALLY | ENEMY&#xa;operation: ADD | MULTIPLY | OVERRIDE | MIN | MAX&#xa;&#xa;Логические состояния (stun, defending и т. п.) — BATTLE_FLAG/effect, не числовая характеристика." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F5FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1180" y="970" width="620" height="185" as="geometry"/></mxCell>

        <mxCell id="ee-1" value="определяет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="e-effect-def" target="e-effect-rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-2" value="имеет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="e-effect-def" target="e-effect-trigger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-3" value="связывает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERone;startArrow=ERmany;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="e-source-link" target="e-effect-def"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-4" value="ACTION source" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="e-action-def" target="e-source-link"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-5" value="ITEM source" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="e-item-template" target="e-source-link"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="e-actor" target="e-actor-stat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="e-stat-def" target="e-actor-stat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-8" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="e-actor" target="e-resource"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-9" value="instance of version" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="e-effect-def" target="e-active-effect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-10" value="1:N targets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="e-active-effect" target="e-active-target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-11" value="target" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="e-actor" target="e-active-target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-12" value="schedules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="e-active-effect" target="e-scheduled-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-13" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="e-battle" target="e-participant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-14" value="actor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="e-actor" target="e-participant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-15" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="e-battle" target="e-battle-action"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-16" value="ordered log" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="e-battle-action" target="e-battle-event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-17" value="used action" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="e-action-def" target="e-battle-action"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ee-18" value="battle-scoped" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="e-battle" target="e-active-effect"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="calculation-flow" name="3. Поток расчёта">
    <mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="f-title" value="Поток применения действия и расчёта эффектов" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="42" as="geometry"/></mxCell>
        <mxCell id="f-app-lane" value="APPLICATION / ТРАНЗАКЦИЯ" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#F4F8FF;swimlaneFillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#0747A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1780" height="250" as="geometry"/></mxCell>
        <mxCell id="f-pure-lane" value="ЧИСТОЕ ЯДРО" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#F3FFF9;swimlaneFillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1780" height="430" as="geometry"/></mxCell>
        <mxCell id="f-time-lane" value="ТАЙМЕРЫ / SCHEDULER" style="swimlane;html=1;horizontal=0;startSize=34;rounded=1;fillColor=#FFF9E6;swimlaneFillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="1780" height="270" as="geometry"/></mxCell>

        <mxCell id="f-step1" value="&lt;b&gt;1. Принять команду&lt;/b&gt;&#xa;character_id проверен сервером&#xa;action_key + target_id&#xa;idempotency_key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="f-step2" value="&lt;b&gt;2. Проверить и заблокировать&lt;/b&gt;&#xa;battle/version, участника, ход, дедлайн&#xa;цель и доступность action&#xa;SELECT … FOR UPDATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="365" y="130" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="f-step3" value="&lt;b&gt;3. Собрать входные данные&lt;/b&gt;&#xa;base stats + ресурсы&#xa;активные эффекты + версии определений&#xa;состояние боя и RNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="f-step11" value="&lt;b&gt;11. Сохранить атомарно&lt;/b&gt;&#xa;Battle.version, ресурсы, ActiveEffect&#xa;BattleAction + ordered BattleEvent&#xa;scheduled events + outbox/WebSocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;strokeWidth=2;fontColor=#0747A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="125" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="f-idempotent" value="Повтор того же idempotency_key возвращает уже сохранённый результат и не применяет эффекты повторно." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="380" height="72" as="geometry"/></mxCell>

        <mxCell id="f-step4" value="&lt;b&gt;4. Immutable snapshot&lt;/b&gt;&#xa;BattleState + EvaluationContext&#xa;Никаких ORM-объектов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="100" y="420" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="f-step5" value="&lt;b&gt;5. Выбрать правила&lt;/b&gt;&#xa;постоянные ActiveEffect&#xa;+ ACTION-scoped эффекты предмета/удара&#xa;+ триггеры текущего события" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="385" y="420" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="f-step6" value="&lt;b&gt;6. Проверить DSL conditions&lt;/b&gt;&#xa;только опубликованный AST&#xa;source / target / action / battle context&#xa;ошибка формулы невозможна в runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="f-step7" value="&lt;b&gt;7. Рассчитать характеристики&lt;/b&gt;&#xa;base → phase/priority&#xa;ADD → MULTIPLY → OVERRIDE&#xa;MIN/MAX → bounds&#xa;Decimal, без float" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1005" y="410" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="f-step8" value="&lt;b&gt;8. Выполнить действие&lt;/b&gt;&#xa;формула урона / крита / лечения&#xa;RNG передан извне&#xa;цель уже разрешена сервером" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1310" y="420" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="f-step9" value="&lt;b&gt;9. Применить операции&lt;/b&gt;&#xa;resource delta / clamp&#xa;apply/refresh/stack/replace effect&#xa;flags и счётчики ходов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1310" y="620" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="f-step10" value="&lt;b&gt;10. Вернуть BattleResult&lt;/b&gt;&#xa;new_state&#xa;resource_changes + effect_changes&#xa;ordered domain events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005" y="620" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="f-pure-note" value="&lt;b&gt;Гарантия чистого ядра&lt;/b&gt;&#xa;Одинаковые snapshot + command + context + RNG дают одинаковый результат. Ядро не выполняет SQL, не читает часы и не отправляет WebSocket." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;" vertex="1" parent="1"><mxGeometry x="385" y="620" width="565" height="105" as="geometry"/></mxCell>

        <mxCell id="f-turn-start" value="&lt;b&gt;TURN_START&lt;/b&gt;&#xa;Вызывается use case начала хода&#xa;TriggerProcessor создаёт операции&#xa;Затем продолжается обычный flow 4→11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFAB00;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="110" y="885" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="f-turn-end" value="&lt;b&gt;TURN_END&lt;/b&gt;&#xa;Вызывается после разрешения action&#xa;уменьшает remaining_turns&#xa;expire выполняется идемпотентно" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFAB00;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="480" y="885" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="f-time-interval" value="&lt;b&gt;TIME_INTERVAL&lt;/b&gt;&#xa;PostgreSQL: ScheduledGameEvent.next_tick_at&#xa;scheduler: FOR UPDATE SKIP LOCKED&#xa;deduplication_key защищает повтор" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFAB00;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="850" y="875" width="330" height="135" as="geometry"/></mxCell>
        <mxCell id="f-time-usecase" value="&lt;b&gt;EffectTick use case&lt;/b&gt;&#xa;Блокирует ActiveEffect + target resource&#xa;проверяет status / next_tick_at&#xa;строит snapshot и запускает тот же TriggerProcessor&#xa;сохраняет delta и планирует следующий тик" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFAB00;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1250" y="865" width="390" height="155" as="geometry"/></mxCell>
        <mxCell id="f-no-sleep" value="Ни бой, ни эффект не держат процесс ожиданием. PostgreSQL хранит deadline/next_tick_at; scheduler только подбирает наступившие события." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="110" y="1040" width="1530" height="42" as="geometry"/></mxCell>

        <mxCell id="fe-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2684FF;strokeWidth=2;" edge="1" parent="1" source="f-step1" target="f-step2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2684FF;strokeWidth=2;" edge="1" parent="1" source="f-step2" target="f-step3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-3" value="prepare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2684FF;strokeWidth=2;fontColor=#0747A6;" edge="1" parent="1" source="f-step3" target="f-step4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;strokeWidth=2;" edge="1" parent="1" source="f-step4" target="f-step5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;strokeWidth=2;" edge="1" parent="1" source="f-step5" target="f-step6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-6" value="valid rules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;" edge="1" parent="1" source="f-step6" target="f-step7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-7" value="computed stats" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;" edge="1" parent="1" source="f-step7" target="f-step8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-8" value="operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;" edge="1" parent="1" source="f-step8" target="f-step9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#36B37E;strokeWidth=2;" edge="1" parent="1" source="f-step9" target="f-step10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-10" value="persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2684FF;strokeWidth=2;fontColor=#0747A6;" edge="1" parent="1" source="f-step10" target="f-step11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-11" value="same trigger path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#FFAB00;fontColor=#172B4D;" edge="1" parent="1" source="f-turn-start" target="f-step5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-12" value="same trigger path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#FFAB00;fontColor=#172B4D;" edge="1" parent="1" source="f-turn-end" target="f-step5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-13" value="due event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#FFAB00;strokeWidth=2;fontColor=#172B4D;" edge="1" parent="1" source="f-time-interval" target="f-time-usecase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe-14" value="snapshot + trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;strokeColor=#FFAB00;fontColor=#172B4D;" edge="1" parent="1" source="f-time-usecase" target="f-step5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
