        </mxCell>
        <mxCell id="a-active-effect" value="&lt;b&gt;ActiveEffect&lt;/b&gt;&#xa;definition + source + battle?&#xa;stacks, expires_at, remaining_turns&#xa;status, next_tick_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="235" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="a-effect-target" value="&lt;b&gt;ActiveEffectTarget&lt;/b&gt;&#xa;SELF | TARGET | ALLY | ENEMY&#xa;Конкретные цели определяет сервер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="700" y="405" width="235" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a-duration" value="&lt;b&gt;Область жизни&lt;/b&gt;&#xa;EQUIPPED · REAL_TIME · TURNS&#xa;BATTLE · ACTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="485" y="405" width="180" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="a-scheduled" value="&lt;b&gt;scheduled_game_events&lt;/b&gt;&#xa;Источник истины для TIME_INTERVAL&#xa;deduplication_key + execute_at&#xa;никаких asyncio.sleep()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="485" y="535" width="450" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="a-stacking" value="INDEPENDENT · STACK · REFRESH · REPLACE  |  max_stacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEEBFF;strokeColor=#2684FF;fontColor=#0747A6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="485" y="660" width="450" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="a-calc-zone" value="ЧИСТЫЙ РАСЧЁТ" style="swimlane;html=1;rounded=1;startSize=34;fillColor=#F3FFF9;swimlaneFillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#006644;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="110" width="750" height="610" as="geometry"/>
        </mxCell>
        <mxCell id="a-snapshot-builder" value="&lt;b&gt;Snapshot Builder&lt;/b&gt;&#xa;Загружает base stats, ресурсы, эффекты и определения&#xa;Создаёт неизменяемое состояние без ORM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1015" y="165" width="220" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="a-context" value="&lt;b&gt;EvaluationContext&lt;/b&gt;&#xa;source, target, action, battle&#xa;turn, timestamp, resource snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1260" y="165" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="a-snapshot" value="&lt;b&gt;BattleState snapshot&lt;/b&gt;&#xa;N участников, команды, активные эффекты&#xa;rng state / seed, version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1490" y="165" width="220" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="a-stat-calc" value="&lt;b&gt;StatCalculator&lt;/b&gt;&#xa;1. base_value&#xa;2. правила по phase + priority&#xa;3. ADD / MULTIPLY / OVERRIDE&#xa;4. MIN / MAX и границы StatDefinition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1015" y="310" width="220" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="a-trigger-processor" value="&lt;b&gt;TriggerProcessor&lt;/b&gt;&#xa;ON_APPLY, TURN_START, TURN_END&#xa;Выдаёт EffectOperation[]&#xa;Не меняет входное состояние" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1260" y="310" width="205" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="a-engine" value="&lt;b&gt;BattleEngine.resolve_action&lt;/b&gt;&#xa;(state, command, context, rng)&#xa;&#xa;Нет FastAPI · Нет SQLAlchemy&#xa;Нет системного времени · Нет sleep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;strokeWidth=2;fontColor=#006644;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1490" y="310" width="220" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="a-result" value="&lt;b&gt;BattleResult&lt;/b&gt;&#xa;new_state&#xa;resource deltas + effects&#xa;ordered domain events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#36B37E;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1490" y="490" width="220" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a-order-note" value="Детерминизм: один snapshot + команда + context + RNG ⇒ один и тот же результат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1015" y="635" width="695" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="a-examples-title" value="ЧЕТЫРЕ ПРИМЕРА НА ОДНОЙ МОДЕЛИ" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="40" y="755" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="a-example-armor" value="&lt;b&gt;1. Надета броня&lt;/b&gt;&#xa;scope = EQUIPPED&#xa;ADD strength: 5&#xa;ADD max_health: 10&#xa;ADD capacity: −2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F5FF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="390" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="a-example-buff" value="&lt;b&gt;2. Бафф на 30 минут&lt;/b&gt;&#xa;scope = REAL_TIME, expires_at = now + 30m&#xa;ADD crit_chance: 10&#xa;ADD max_health: 20&#xa;ADD luck: 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FF;strokeColor=#2684FF;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="800" width="390" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="a-example-poison" value="&lt;b&gt;3. Яд / лечение со временем&lt;/b&gt;&#xa;RESOURCE_DELTA current_health: −10&#xa;TIME_INTERVAL = 5s или every_n_turns = 3&#xa;Банка: +23 / 10s&#xa;Тики — события, не модификаторы max_health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBE6;strokeColor=#FF5630;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="880" y="800" width="390" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="a-example-hit" value="&lt;b&gt;4. Усиление одного удара&lt;/b&gt;&#xa;scope = ACTION&#xa;Сфера: ADD crit_chance: 45%&#xa;Амулет: MULTIPLY crit_chance: 1.25&#xa;MULTIPLY hit_power: 1.31&#xa;После action эффекты не сохраняются" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3FCEF;strokeColor=#36B37E;fontColor=#172B4D;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1300" y="800" width="440" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="a-example-dependent" value="Пример зависимой формулы: value = clamp(value_before + source.stat(&quot;strength&quot;) × 0.30, 0, 100)&#xa;Администратор может добавить характеристику, но она влияет на игру только после ссылки из правила или системной формулы." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="1700" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ae-1" value="описывает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="a-effect-def" target="a-rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-2" value="запускает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="a-effect-def" target="a-trigger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-3" value="источник" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="a-action-def" target="a-effect-def"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-4" value="источник" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6554C0;fontColor=#403294;" edge="1" parent="1" source="a-item-template" target="a-effect-def"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-5" value="валидирует" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#FFAB00;fontColor=#172B4D;" edge="1" parent="1" source="a-dsl" target="a-rule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-6" value="имеет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="a-actor" target="a-stat-value"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-7" value="имеет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="a-actor" target="a-resource"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-8" value="создаёт EQUIPPED effect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="a-equipment" target="a-active-effect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-9" value="действует на" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="a-active-effect" target="a-effect-target"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-10" value="планирует тик" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2684FF;fontColor=#0747A6;" edge="1" parent="1" source="a-active-effect" target="a-scheduled"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-11" value="читает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="a-active-effect" target="a-snapshot-builder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-12" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="a-snapshot-builder" target="a-snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-13" value="контекст" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="a-context" target="a-stat-calc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ae-14" value="computed stats" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="a-stat-calc" target="a-engine"><mxGeometry relative="1" as="geometry"/></mxCell>
