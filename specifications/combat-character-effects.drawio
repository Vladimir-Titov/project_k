        <mxCell id="a-stat-def" value="&lt;b&gt;StatDefinition&lt;/b&gt;&#xa;Динамический каталог характеристик&#xa;key, scale, min, max, default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="165" width="160" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="a-action-def" value="&lt;b&gt;ActionDefinition&lt;/b&gt;&#xa;Удар, банка, способность&#xa;cost, cooldown, target rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="245" y="165" width="160" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="a-item-template" value="&lt;b&gt;ItemTemplate&lt;/b&gt;&#xa;Броня, сфера, амулет&#xa;equip/consume/use" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="275" width="160" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="a-effect-def" value="&lt;b&gt;EffectDefinition&lt;/b&gt;&#xa;duration_scope, stacking_policy, max_stacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6554C0;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="245" y="275" width="160" height="84" as="geometry"/>
        </mxCell>
