        </mxCell>
        <mxCell id="a-equipment" value="&lt;b&gt;Equipment&lt;/b&gt;&#xa;Надетые ItemInstance&#xa;Источник эффекта EQUIPPED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2684FF;fontColor=#172B4D;" vertex="1" parent="1">
