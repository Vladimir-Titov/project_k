        </mxCell>
        <mxCell id="a-dsl" value="&lt;b&gt;Безопасный DSL + публикация&lt;/b&gt;&#xa;source.stat(...), target.stat(...), base, value_before&#xa;+ − × ÷, compare, min/max/clamp&#xa;Парсер → типы → граф зависимостей → запрет циклов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0B3;strokeColor=#FFAB00;fontColor=#172B4D;align=left;spacingLeft=12;" vertex="1" parent="1">
