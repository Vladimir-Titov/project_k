        <mxCell id="ae-17" value="возвращает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#36B37E;fontColor=#006644;" edge="1" parent="1" source="a-engine" target="a-result"><mxGeometry relative="1" as="geometry"/></mxCell>
