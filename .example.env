# Application
APP_NAME=Project K
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_DOCS_ENABLED=true
# Complex values use JSON syntax.
APP_CORS_ORIGINS=["*"]

# Administration panel
ADMIN_ENABLED=false
ADMIN_LOGIN=admin
ADMIN_PASSWORD=local-development-admin-password
# Replace with at least 32 random bytes in every deployed environment.
ADMIN_SESSION_SECRET=local-development-admin-session-secret
ADMIN_TITLE=Project K Admin
ADMIN_SESSION_MAX_AGE_SECONDS=28800
ADMIN_SECURE_COOKIES=false

# Authentication
# Replace this value in every deployed environment. Use at least 32 random bytes.
AUTH_SECRET_KEY=local-development-secret-key-change-me
AUTH_ALGORITHM=HS256
AUTH_ISSUER=project-k
AUTH_AUDIENCE=project-k-client
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=40321
DB_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# The pool opens exactly this many connections per Uvicorn worker at startup.
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_MAX_QUERIES=50000
DB_MAX_INACTIVE_CONNECTION_LIFETIME=300
DB_POOL_CLOSE_TIMEOUT=10
DB_APPLICATION_NAME=project-k

# Logging
LOG_LEVEL=INFO
LOG_SQL_LEVEL=WARNING
LOG_ACCESS_LOG=true

# Reserved for a future Sentry-compatible SDK integration (for example, GlitchTip).
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
