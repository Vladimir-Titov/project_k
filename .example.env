# Application
APP_NAME=Project K
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_DOCS_ENABLED=true
# Complex values use JSON syntax.
APP_CORS_ORIGINS=["*"]

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=40321
DB_DATABASE=postgres
DB_USER=postgres
DB_PASSWORD=postgres
# The pool opens exactly this many connections per Uvicorn worker at startup.
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_MAX_QUERIES=50000
DB_MAX_INACTIVE_CONNECTION_LIFETIME=300
DB_POOL_CLOSE_TIMEOUT=10
DB_APPLICATION_NAME=project-k

# Logging
LOG_LEVEL=INFO
LOG_SQL_LEVEL=WARNING
LOG_ACCESS_LOG=true

# Reserved for a future Sentry-compatible SDK integration (for example, GlitchTip).
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
